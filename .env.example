# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database (SQLite by default; override only if needed)
DATABASE_URL=sqlite:///instance/amoja-smanager.db

# Owner provisioning, used only by `make owner`. Keep real values private.
# AUTH_USERNAME=owner
# AUTH_PASSWORD=change-me-to-a-long-passphrase

# Presentation and storage
APP_TIMEZONE=UTC
MEDIA_ROOT=instance/media

# Upload ceiling in bytes (100 MiB)
MAX_CONTENT_LENGTH=104857600
